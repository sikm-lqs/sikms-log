---
import BaseLayout from "./BaseLayout.astro";
import type { MarkdownHeading } from "astro";
import TableOfContents from "../components/content/TableOfContents.astro";
import { getTocHeadings } from "../lib/content/headings";
import { ui } from "../i18n/ui";
import {
  formatDate,
  type SiteCollection,
  type SiteLang,
} from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  lang: SiteLang;
  currentPath: string;
  translationHref?: string;
  collection: SiteCollection;
  publishedAt: string;
  updatedAt?: string;
  readTime?: string;
  tags?: string[];
  cover?: string;
  coverAlt?: string;
  backHref: string;
  wordCount?: number | string;
  headings?: MarkdownHeading[];
}

const {
  title,
  description,
  lang,
  currentPath,
  translationHref,
  publishedAt,
  updatedAt,
  readTime,
  tags = [],
  cover,
  coverAlt = "",
  backHref,
  wordCount,
  headings = [],
} = Astro.props;

const copy = ui[lang];
const tocHeadings = getTocHeadings(headings);
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  currentPath={currentPath}
  translationHref={translationHref}
>
  <section class="pb-20 pt-14">
    <div class:list={["article-shell", { "has-toc": tocHeadings.length > 0 }]}>
      <header class="article-header">
        <!-- 小型面包屑：首页 > 博客 (支持中英) -->
        <div class="flat-item-meta">
          <a href={lang === 'zh-CN' ? '/' : '/en'}>{lang === 'zh-CN' ? '首页' : 'Home'}</a>
          <span aria-hidden="true">›</span>
          <a href={backHref}>{lang === 'zh-CN' ? '博客' : 'Blog'}</a>
        </div>

        <div class="flat-item-meta mt-3">
          <span>{formatDate(publishedAt, lang)}</span>
          {readTime && <span>· {readTime}</span>}
          {wordCount && <span>· {wordCount} {lang === 'zh-CN' ? '字' : 'words'}</span>}
          {updatedAt && (
            <span>· {copy.labels.updatedAt} {formatDate(updatedAt, lang)}</span>
          )}
        </div>

        <h1 class="mt-5 text-3xl font-semibold leading-[1.25] tracking-tight text-[var(--text-main)] sm:text-4xl">
          {title}
        </h1>
        <p class="mt-5 text-lg leading-8 text-[var(--text-muted)]">{description}</p>
        {tags.length > 0 && (
          <p class="flat-item-tags mt-6">{tags.join(" · ")}</p>
        )}
        {cover && (
          <img
            src={cover}
            alt={coverAlt}
            class="mt-8 rounded-[1rem] border border-[var(--border-strong)] bg-[var(--surface)]"
          />
        )}
      </header>
      {tocHeadings.length > 0 && <TableOfContents headings={tocHeadings} lang={lang} />}
      <article class="rich-content article-body">
        <slot />
      </article>
    </div>
  </section>
</BaseLayout>
